# Copy to .env (git-ignored) and fill in the key you have. Both scripts read these from the
# environment, so exporting them in your shell works too.

# Respan API key — generate_spec.js sends its Gemini call through the Respan gateway with this key,
# and each generation is logged as a trace at https://platform.respan.ai (Observability › Logs).
# Create one under Gateway › API keys. Leave empty to call Google directly instead.
RESPAN_API_KEY=

# Direct-to-Google fallback, used only when RESPAN_API_KEY is empty.
GOOGLE_GENERATIVE_API_KEY=

# Optional: Respan Enterprise setups point the gateway at their own host.
# RESPAN_BASE_URL=https://endpoint.respan.ai/api
